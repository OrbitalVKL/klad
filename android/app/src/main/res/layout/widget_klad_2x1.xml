<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2 × 1 (2.3.1) : montant, heure de la dernière synchro dessous, pastille en haut à droite. Fond et couleurs
     posés par WidgetKlad selon le style choisi ; valeurs ci-dessous = style Orbital (aperçu). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fond_orbital">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/w_montant"
            style="@style/WidgetMontant"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="12sp"
            android:text="@string/widget_apercu_montant" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_bas_icone"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_synchro" />

            <TextView
                android:id="@+id/w_bas_texte"
                style="@style/WidgetBas"
                android:text="@string/widget_apercu_heure" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_pastille"
        style="@style/WidgetPastille" />
</FrameLayout>
