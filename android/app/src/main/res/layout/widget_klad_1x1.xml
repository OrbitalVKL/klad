<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1 × 1 (2.3.1) : montant seul, pastille en haut à droite. Pas de place pour l'heure : synchro ancienne ou
     banque à reconnecter = bordure ambre (fond « alerte »). Couleurs posées par WidgetKlad. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fond_orbital">

    <TextView
        android:id="@+id/w_montant"
        style="@style/WidgetMontant"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="9sp"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/widget_apercu_montant" />

    <TextView
        android:id="@+id/w_pastille"
        style="@style/WidgetPastille" />
</FrameLayout>
