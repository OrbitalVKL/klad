<?xml version="1.0" encoding="utf-8"?>
<!-- Widget d'écran d'accueil (2.3.0), 2 × 2 cases, sans logo ni légende (maquette validée le 09/11/2026). Les trois
     montants (bleu, rouge, gris) et les deux lignes du bas (normale, ambre) sont choisis par visibilité : leurs couleurs
     viennent des ressources et suivent le thème du téléphone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fond"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_montant_bleu"
            style="@style/WidgetMontant"
            android:textColor="@color/w_bleu" />

        <TextView
            android:id="@+id/w_montant_rouge"
            style="@style/WidgetMontant"
            android:textColor="@color/w_rouge"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_montant_gris"
            style="@style/WidgetMontant"
            android:text="@string/widget_vide"
            android:textColor="@color/w_muet"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_pastille"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:background="@drawable/w_pastille"
        android:gravity="center"
        android:minWidth="30dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/w_pastille_texte"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_bas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_bas_icone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_synchro"
            android:tint="@color/w_muet" />

        <TextView
            android:id="@+id/w_bas_texte"
            style="@style/WidgetBas"
            android:textColor="@color/w_muet" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_bas_ambre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_bas_ambre_icone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_horloge"
            android:tint="@color/w_ambre" />

        <TextView
            android:id="@+id/w_bas_ambre_texte"
            style="@style/WidgetBas"
            android:textColor="@color/w_ambre" />
    </LinearLayout>
</FrameLayout>
