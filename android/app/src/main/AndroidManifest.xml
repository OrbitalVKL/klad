<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucune sauvegarde Android (cloud ou transfert d'appareil) : le coffre ne quitte jamais le téléphone. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Retour bancaire : klad://eb?code=…&state=… (relayé par site/retour.html) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="klad" android:host="eb" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Lien Grafit : résumé en lecture seule, content://${applicationId}.grafit/summary.
             Exporté sans permission (Grafit est une autre appli) : GrafitProvider.query() n'accepte que l'UID de
             fr.orbitalvkl.grafit signé par le certificat attendu (SecurityException sinon). -->
        <provider
            android:name="app.klad.grafit.GrafitProvider"
            android:authorities="${applicationId}.grafit"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />

        <!-- 2.3.0 : widget d'écran d'accueil 2 × 1 depuis la 2.3.1 (reste à vivre, opérations à vérifier). Exporté : Android lui envoie
             les mises à jour du widget ; il ne reçoit rien d'autre. -->
        <receiver
            android:name="app.klad.widget.WidgetKlad"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_klad_info" />
        </receiver>

        <!-- 2.3.1 : widget 1 × 1 (même rôle que le 2 × 1 ci-dessus). -->
        <receiver
            android:name="app.klad.widget.WidgetKladPetit"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_klad_petit_info" />
        </receiver>

        <!-- 2.3.0 : synchro planifiée (8 h et 14 h), seulement si elle est activée dans Plus › Verrou. -->
        <service
            android:name="app.klad.fond.FondJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>

    <!-- Android 11 et plus : Grafit visible par Klad, pour contrôler son paquet et sa signature. -->
    <queries>
        <package android:name="fr.orbitalvkl.grafit" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Mise à jour depuis l'appli (KladUpdate) : Android demande confirmation à chaque installation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Retour haptique léger au seuil des gestes sur les opérations (navigator.vibrate de la WebView, 0.10.7). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 2.3.0 : la synchro planifiée reste programmée après un redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
